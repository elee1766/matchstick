#!/sbin/openrc-run

description="matchstick nftables firewall"

MSCTL="${MSCTL:-/usr/local/bin/msctl}"

depend() {
	before net
	use logger
}

start() {
	ebegin "Starting matchstick firewall"
	"$MSCTL" enable
	eend $?
}

stop() {
	ebegin "Stopping matchstick firewall"
	"$MSCTL" disable
	eend $?
}

reload() {
	ebegin "Reloading matchstick firewall"
	"$MSCTL" enable
	eend $?
}

status() {
	"$MSCTL" status >/dev/null 2>&1
	if [ $? -eq 0 ]; then
		einfo "matchstick firewall is active"
		return 0
	else
		einfo "matchstick firewall is not active"
		return 3
	fi
}
