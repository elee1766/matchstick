table inet matchstick
delete table inet matchstick

table inet matchstick {

    set crowdsec4 {
        type ipv4_addr
        flags timeout
    }

    set crowdsec6 {
        type ipv6_addr
        flags timeout
    }

    set _lograte_4 {
        type ipv4_addr
        flags dynamic, timeout
        size 65535
        timeout 60s
    }

    set _lograte_6 {
        type ipv6_addr
        flags dynamic, timeout
        size 65535
        timeout 60s
    }

    map input_zones {
        type ifname : verdict
        elements = {
            "eth1" : jump inet_to_fw,
            "eth3" : jump home_to_fw,
            "docker0" : jump dock_to_fw
        }
    }

    map output_zones {
        type ifname : verdict
        elements = {
            "eth1" : jump fw_to_inet,
            "eth3" : jump fw_to_home,
            "docker0" : jump fw_to_dock
        }
    }

    map forward_zones {
        type ifname . ifname : verdict
        elements = {
            "docker0" . "docker0" : jump dock_to_dock,
            "docker0" . "eth3" : jump dock_to_home,
            "docker0" . "eth1" : jump dock_to_inet,
            "eth3" . "docker0" : jump home_to_dock,
            "eth3" . "eth3" : jump home_to_home,
            "eth3" . "eth1" : jump home_to_inet,
            "eth1" . "docker0" : jump inet_to_dock,
            "eth1" . "eth3" : jump inet_to_home
        }
    }

    chain icmp_v4 {
        icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
    }

    chain icmp_v6 {
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert, mld-listener-query, mld-listener-report } accept
    }

    chain rpfilter {
        type filter hook prerouting priority filter + 5; policy accept;
        fib saddr . mark . iif oif 0 drop
    }

    chain anti_smurf {
        fib saddr type broadcast drop
        fib saddr type multicast drop
    }

    chain input {
        type filter hook input priority filter + 5; policy drop;
        iif lo accept
        ct state { established, related } accept
        ct state invalid drop
        jump anti_smurf
        iifname eth1 udp dport 68 udp sport 67 accept
        iifname eth3 udp dport 67 udp sport 68 accept
        tcp flags & (fin|syn|rst|psh|ack|urg) == 0 drop comment "tcp-strict: null flags"
        tcp flags & (fin|syn) == (fin|syn) drop comment "tcp-strict: fin+syn"
        tcp flags & (syn|rst) == (syn|rst) drop comment "tcp-strict: syn+rst"
        jump icmp_v4
        jump icmp_v6
        iifname vmap @input_zones
        update @_lograte_4 { ip saddr limit rate 5/minute burst 5 packets } log prefix "matchstick input DROP "
        update @_lograte_6 { ip6 saddr limit rate 5/minute burst 5 packets } log prefix "matchstick input DROP "
        drop
    }

    chain forward {
        type filter hook forward priority filter + 5; policy drop;
        ct state { established, related } accept
        ct state invalid drop
        jump anti_smurf
        fib daddr type broadcast drop
        fib daddr type multicast drop
        iifname . oifname vmap @forward_zones
        update @_lograte_4 { ip saddr limit rate 5/minute burst 5 packets } log prefix "matchstick forward DROP "
        drop
    }

    chain output {
        type filter hook output priority filter + 5; policy accept;
        oifname eth3 udp dport 68 udp sport 67 accept
        oifname vmap @output_zones
    }

    chain dock_to_dock { accept }

    chain dock_to_fw {
        tcp dport 53 accept
        udp dport 53 accept
        reject with icmpx admin-prohibited
    }

    chain dock_to_home { accept }

    chain dock_to_inet { accept }

    chain fw_to_dock { accept }

    chain fw_to_home { accept }

    chain fw_to_inet { accept }

    chain home_to_dock {
        meta nfproto vmap { ipv4 : jump home_to_dock_4, ipv6 : jump home_to_dock_6 }
    }

    chain home_to_dock_4 {
        ip daddr 172.17.0.3 udp dport 52000-52100 accept
        reject with icmpx admin-prohibited
    }

    chain home_to_dock_6 {
        reject with icmpx admin-prohibited
    }

    chain home_to_fw {
        meta nfproto vmap { ipv4 : jump home_to_fw_4, ipv6 : jump home_to_fw_6 }
    }

    chain home_to_fw_4 {
        tcp dport 53 accept
        udp dport 53 accept
        icmp type echo-request accept
        ip saddr 192.168.0.67 tcp dport 3000 accept
        ip saddr 192.168.0.44 tcp dport 3000 accept
        ip saddr 192.168.0.67 tcp dport 667 accept
        ip saddr 192.168.0.44 tcp dport { 443, 80, 8448 } accept
        ip saddr 192.168.0.44 udp dport 80 accept
        ip saddr 192.168.0.67 tcp dport { 22, 80, 443, 8448 } accept
        ip saddr 192.168.0.67 udp dport 52000-52100 accept
        accept
    }

    chain home_to_fw_6 {
        tcp dport 53 accept
        udp dport 53 accept
        accept
    }

    chain home_to_home {
        meta nfproto vmap { ipv4 : jump home_to_home_4, ipv6 : jump home_to_home_6 }
    }

    chain home_to_home_4 {
        icmp type echo-request accept
        ip saddr 192.168.0.67 ip daddr 192.168.0.86 tcp dport 8384 accept
        udp dport 1900 accept
        reject with icmpx admin-prohibited
    }

    chain home_to_home_6 {
        udp dport 1900 accept
        reject with icmpx admin-prohibited
    }

    chain home_to_inet {
        meta nfproto vmap { ipv4 : jump home_to_inet_4, ipv6 : jump home_to_inet_6 }
    }

    chain home_to_inet_4 {
        icmp type echo-request accept
        accept
    }

    chain home_to_inet_6 { accept }

    chain inet_to_dock {
        reject with icmpx admin-prohibited
    }

    chain inet_to_fw {
        meta nfproto vmap { ipv4 : jump inet_to_fw_4, ipv6 : jump inet_to_fw_6 }
    }

    chain inet_to_fw_4 {
        ip saddr @crowdsec4 drop
        icmp type echo-request accept
        tcp dport { 443, 80, 8448 } accept
        udp dport 443 accept
        udp dport 52000-52100 accept
        tcp dport 32400 accept
        udp dport { 1900, 32410, 32412-32414 } accept
        update @_lograte_4 { ip saddr limit rate 5/minute burst 5 packets } log prefix "matchstick inet_to_fw drop "
        drop
    }

    chain inet_to_fw_6 {
        ip6 saddr @crowdsec6 drop
        tcp dport { 443, 80, 8448 } accept
        udp dport 443 accept
        udp dport 52000-52100 accept
        tcp dport 32400 accept
        udp dport { 1900, 32410, 32412-32414 } accept
        update @_lograte_6 { ip6 saddr limit rate 5/minute burst 5 packets } log prefix "matchstick inet_to_fw drop "
        drop
    }

    chain inet_to_home {
        meta nfproto vmap { ipv4 : jump inet_to_home_4, ipv6 : jump inet_to_home_6 }
    }

    chain inet_to_home_4 {
        ip saddr @crowdsec4 drop
        ip daddr 192.168.0.86 tcp dport 32400 accept
        ip daddr 192.168.0.86 udp dport 1900 accept
        ip daddr 192.168.0.86 udp dport 32410-32414 accept
        tcp dport 6881-6999 accept
        udp dport 6881-6999 accept
        update @_lograte_4 { ip saddr limit rate 5/minute burst 5 packets } log prefix "matchstick inet_to_home drop "
        drop
    }

    chain inet_to_home_6 {
        ip6 saddr @crowdsec6 drop
        tcp dport 6881-6999 accept
        udp dport 6881-6999 accept
        update @_lograte_6 { ip6 saddr limit rate 5/minute burst 5 packets } log prefix "matchstick inet_to_home drop "
        drop
    }
}

table inet matchstick_nat
delete table inet matchstick_nat

table inet matchstick_nat {

    chain prerouting {
        type nat hook prerouting priority dstnat + 5; policy accept;
        iifname eth1 tcp dport 32400 dnat ip to 192.168.0.86
        iifname eth1 udp dport 1900 dnat ip to 192.168.0.86
        iifname eth1 udp dport 32410-32414 dnat ip to 192.168.0.86
        iifname eth3 ip daddr 108.210.198.229 udp dport 52000-52100 dnat ip to 172.17.0.3
    }

    chain postrouting {
        type nat hook postrouting priority srcnat + 5; policy accept;
        ip saddr 192.168.0.0/16 oifname eth1 masquerade
        ip saddr 172.17.0.0/12 oifname eth1 masquerade
        ip saddr 192.168.0.0/16 ip daddr 192.168.0.1 oifname eth3 tcp dport { 80, 443, 32400 } snat ip to 192.168.0.1
        ip saddr 192.168.0.0/16 ip daddr 172.17.0.3 oifname docker0 udp dport 52000-52100 snat ip to 172.17.0.1
    }
}

