[Unit]
Description=matchstick nftables firewall
Documentation=https://github.com/elee1766/matchstick
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/matchstick apply /etc/matchstick/firewall.lua
ExecReload=/usr/bin/matchstick apply /etc/matchstick/firewall.lua
ExecStop=/bin/sh -c 'printf "delete table inet matchstick\ndelete table inet matchstick_nat\n" | /usr/bin/nft -f -'

# Security hardening
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/proc/sys
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
