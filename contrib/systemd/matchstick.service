[Unit]
Description=matchstick nftables firewall
Documentation=https://github.com/elee1766/matchstick
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/msctl enable
ExecReload=/usr/local/bin/msctl enable
ExecStop=/usr/local/bin/msctl disable

# Security hardening
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/proc/sys
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
