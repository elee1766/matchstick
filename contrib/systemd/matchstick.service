[Unit]
Description=matchstick nftables firewall
Documentation=https://github.com/elee1766/matchstick
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
After=systemd-sysctl.service
Conflicts=shutdown.target
ConditionPathExists=/etc/matchstick/firewall.lua

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/matchstick apply /etc/matchstick/firewall.lua
ExecReload=/usr/bin/matchstick apply /etc/matchstick/firewall.lua
ExecStop=/usr/bin/nft delete table inet matchstick

# Security hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=no
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
