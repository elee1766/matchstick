table inet matchstick
delete table inet matchstick

table inet matchstick {

    set blocklist4 {
        type ipv4_addr
        flags timeout
    }

    set blocklist6 {
        type ipv6_addr
        flags timeout
    }

    set bogons {
        type ipv4_addr
        flags interval
        elements = { 0.0.0.0/8, 127.0.0.0/8, 169.254.0.0/16, 224.0.0.0/3 }
    }

    set _lograte_4 {
        type ipv4_addr
        flags dynamic, timeout
        size 65535
        timeout 60s
    }

    set _lograte_6 {
        type ipv6_addr
        flags dynamic, timeout
        size 65535
        timeout 60s
    }

    map input_zones {
        type ifname : verdict
        elements = {
            "eth0" : jump wan_to_fw,
            "eth1" : jump lan_to_fw,
            "eth2" : jump dmz_to_fw,
            "docker0" : jump dock_to_fw
        }
    }

    map output_zones {
        type ifname : verdict
        elements = {
            "eth0" : jump fw_to_wan,
            "eth1" : jump fw_to_lan,
            "eth2" : jump fw_to_dmz,
            "docker0" : jump fw_to_dock
        }
    }

    map forward_zones {
        type ifname . ifname : verdict
        elements = {
            eth2 . eth0 : jump dmz_to_wan,
            docker0 . docker0 : jump dock_to_dock,
            docker0 . eth0 : jump dock_to_wan,
            eth1 . eth2 : jump lan_to_dmz,
            eth1 . eth1 : jump lan_to_lan,
            eth1 . eth0 : jump lan_to_wan,
            eth0 . eth2 : jump wan_to_dmz,
            eth0 . docker0 : jump wan_to_dock,
            eth0 . eth1 : jump wan_to_lan
        }
    }

    chain icmp_v4 {
        icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
        icmp type echo-request limit rate 10/second burst 5 packets accept
    }

    chain icmp_v6 {
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert, mld-listener-query, mld-listener-report } accept
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept
        icmpv6 type echo-request limit rate 10/second burst 5 packets accept
        meta nfproto ipv6 drop
    }

    chain rpfilter {
        type filter hook prerouting priority filter + 5; policy accept;
        fib saddr . mark . iif oif 0 drop
    }

    chain anti_smurf {
        fib saddr type broadcast drop
        fib saddr type multicast drop
    }

    chain input {
        type filter hook input priority filter + 5; policy drop;
        iif lo accept
        ct state { established, related } accept
        ct state invalid drop
        jump anti_smurf
        iifname eth0 udp sport 67 udp dport 68 accept
        iifname eth1 udp sport 68 udp dport 67 accept
        jump tcp_strict
        jump icmp_v4
        jump icmp_v6
        iifname vmap @input_zones
        update @_lograte_4 { ip saddr limit rate 5/minute burst 5 packets } log prefix "matchstick input DROP "
        update @_lograte_6 { ip6 saddr limit rate 5/minute burst 5 packets } log prefix "matchstick input DROP "
        drop
    }

    chain tcp_strict {
        tcp flags ! fin,syn,rst,psh,ack,urg drop comment "tcp-strict: null flags"
        tcp flags & (fin|syn) fin|syn drop comment "tcp-strict: fin+syn"
        tcp flags & (syn|rst) syn|rst drop comment "tcp-strict: syn+rst"
        tcp flags & (fin|psh|urg) fin|psh|urg drop comment "tcp-strict: xmas"
        tcp flags & (fin|syn|rst|ack) != syn ct state new drop comment "tcp-strict: new non-syn"
    }

    chain forward {
        type filter hook forward priority filter + 5; policy drop;
        ct state { established, related } accept
        ct state invalid drop
        jump anti_smurf
        jump tcp_strict
        fib daddr type broadcast drop
        fib daddr type multicast drop
        iifname . oifname vmap @forward_zones
        update @_lograte_4 { ip saddr limit rate 5/minute burst 5 packets } log prefix "matchstick forward DROP "
        update @_lograte_6 { ip6 saddr limit rate 5/minute burst 5 packets } log prefix "matchstick forward DROP "
        drop
    }

    chain output {
        type filter hook output priority filter + 5; policy accept;
        oifname eth1 udp sport 67 udp dport 68 accept
        oifname vmap @output_zones
    }

    chain dmz_to_fw {
        tcp dport 53 accept
        udp dport 53 accept
        udp dport 123 accept
        reject with icmpx admin-prohibited
    }

    chain dmz_to_wan {
        accept
    }

    chain dock_to_dock {
        accept
    }

    chain dock_to_fw {
        tcp dport 53 accept
        udp dport 53 accept
        reject with icmpx admin-prohibited
    }

    chain dock_to_wan {
        accept
    }

    chain fw_to_dmz {
        accept
    }

    chain fw_to_dock {
        accept
    }

    chain fw_to_lan {
        accept
    }

    chain fw_to_wan {
        accept
    }

    chain lan_to_dmz {
        meta nfproto vmap { ipv4 : jump lan_to_dmz_4, ipv6 : jump lan_to_dmz_6 }
    }

    chain lan_to_dmz_4 {
        ip daddr 172.16.0.10 tcp dport { 80, 443 } accept
        accept
    }

    chain lan_to_dmz_6 {
        accept
    }

    chain lan_to_fw {
        meta nfproto vmap { ipv4 : jump lan_to_fw_4, ipv6 : jump lan_to_fw_6 }
    }

    chain lan_to_fw_4 {
        tcp dport 53 accept
        udp dport 53 accept
        icmp type echo-request accept
        ip saddr 10.0.0.10 tcp dport 22 accept
        ip saddr 10.0.0.10 tcp dport { 3000, 8080, 9090 } accept
        ip saddr 10.0.0.100 tcp dport 53 accept
        ip saddr 10.0.0.100 udp dport 53 accept
        ip saddr 10.0.0.100 drop
        accept
    }

    chain lan_to_fw_6 {
        tcp dport 53 accept
        udp dport 53 accept
        accept
    }

    chain lan_to_lan {
        meta nfproto vmap { ipv4 : jump lan_to_lan_4, ipv6 : jump lan_to_lan_6 }
    }

    chain lan_to_lan_4 {
        icmp type echo-request accept
        ip saddr 10.0.0.10 ip daddr 10.0.0.20 tcp dport 22 accept
        ip saddr 10.0.0.10 ip daddr 10.0.0.20 tcp dport 8384 accept
        udp dport 1900 accept
        reject with icmpx admin-prohibited
    }

    chain lan_to_lan_6 {
        udp dport 1900 accept
        reject with icmpx admin-prohibited
    }

    chain lan_to_wan {
        meta nfproto vmap { ipv4 : jump lan_to_wan_4, ipv6 : jump lan_to_wan_6 }
    }

    chain lan_to_wan_4 {
        icmp type echo-request accept
        accept
    }

    chain lan_to_wan_6 {
        accept
    }

    chain wan_to_dmz {
        meta nfproto vmap { ipv4 : jump wan_to_dmz_4, ipv6 : jump wan_to_dmz_6 }
    }

    chain wan_to_dmz_4 {
        ip daddr 172.16.0.10 tcp dport 443 accept
        ip daddr 172.16.0.10 udp dport 443 accept
        ip daddr 172.16.0.10 tcp dport 8080 accept
        ip daddr 172.16.0.10 udp dport 9000 accept
        ip daddr 172.16.0.10 udp dport 9100-9200 accept
        update @_lograte_4 { ip saddr limit rate 5/minute burst 5 packets } log prefix "matchstick wan_to_dmz drop "
        drop
    }

    chain wan_to_dmz_6 {
        update @_lograte_6 { ip6 saddr limit rate 5/minute burst 5 packets } log prefix "matchstick wan_to_dmz drop "
        drop
    }

    chain wan_to_dock {
        reject with icmpx admin-prohibited
    }

    chain wan_to_fw {
        meta nfproto vmap { ipv4 : jump wan_to_fw_4, ipv6 : jump wan_to_fw_6 }
    }

    chain wan_to_fw_4 {
        ip saddr @blocklist4 drop
        icmp type echo-request accept
        tcp dport 443 accept
        udp dport 443 accept
        tcp dport 22 accept
        tcp dport 22 accept
        tcp dport { 8080, 8443, 9090 } accept
        udp dport 10000-10100 accept
        update @_lograte_4 { ip saddr limit rate 5/minute burst 5 packets } log prefix "matchstick wan_to_fw drop "
        drop
    }

    chain wan_to_fw_6 {
        ip6 saddr @blocklist6 drop
        tcp dport 443 accept
        udp dport 443 accept
        tcp dport 22 accept
        tcp dport 22 accept
        tcp dport { 8080, 8443, 9090 } accept
        udp dport 10000-10100 accept
        update @_lograte_6 { ip6 saddr limit rate 5/minute burst 5 packets } log prefix "matchstick wan_to_fw drop "
        drop
    }

    chain wan_to_lan {
        meta nfproto vmap { ipv4 : jump wan_to_lan_4, ipv6 : jump wan_to_lan_6 }
    }

    chain wan_to_lan_4 {
        ip daddr 10.0.0.20 tcp dport 22 accept
        update @_lograte_4 { ip saddr limit rate 5/minute burst 5 packets } log prefix "matchstick wan_to_lan drop "
        drop
    }

    chain wan_to_lan_6 {
        update @_lograte_6 { ip6 saddr limit rate 5/minute burst 5 packets } log prefix "matchstick wan_to_lan drop "
        drop
    }
}

table inet matchstick_nat
delete table inet matchstick_nat

table inet matchstick_nat {

    chain prerouting {
        type nat hook prerouting priority dstnat + 5; policy accept;
        iifname eth0 tcp dport 443 dnat ip to 172.16.0.10
        iifname eth0 udp dport 443 dnat ip to 172.16.0.10
        iifname eth0 tcp dport 8080 dnat ip to 172.16.0.10
        iifname eth0 udp dport 9000 dnat ip to 172.16.0.10
        iifname eth0 udp dport 9100-9200 dnat ip to 172.16.0.10
        iifname eth0 tcp dport 2222 dnat ip to 10.0.0.20:22
        iifname eth1 ip daddr 203.0.113.1 tcp dport 80 dnat ip to 172.16.0.10
        iifname eth1 ip daddr 203.0.113.1 tcp dport 443 dnat ip to 172.16.0.10
    }

    chain postrouting {
        type nat hook postrouting priority srcnat + 5; policy accept;
        ip saddr 10.0.0.0/8 oifname eth0 masquerade
        ip saddr 172.16.0.0/12 oifname eth0 masquerade
        ip saddr 172.16.0.0/12 oifname eth0 masquerade
        ip saddr 10.0.0.0/8 ip daddr 172.16.0.10 oifname eth2 tcp dport { 80, 443 } snat ip to 172.16.0.1
    }
}

